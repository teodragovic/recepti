---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const recipes = await getCollection('recipes');
recipes.sort((a, b) => a.data.title.localeCompare(b.data.title, 'hr'));

const base = import.meta.env.BASE_URL;
---

<Layout title="Recepti">
    <div class="page-head">
        <h1>Recepti</h1>
        <p class="intro">{recipes.length} recepata iz kuhinje.</p>
    </div>

    <ul class="recipe-list">
        {
            recipes.map((recipe) => {
                const { title, tags, servings, calories } = recipe.data;
                const meta: string[] = [];
                if (servings) meta.push(`${servings} ${Number(servings) < 5 ? 'osobe' : 'osoba'}`);
                if (calories) meta.push(`~${calories} kcal`);
                return (
                    <li>
                        <a class="card" href={`${base}${recipe.id}/`}>
                            <span class="card__title">{title}</span>
                            {meta.length > 0 && <span class="card__meta">{meta.join(' · ')}</span>}
                            {tags.length > 0 && (
                                <span class="card-tags">
                                    {tags.map((t) => (
                                        <span class="tag">{t}</span>
                                    ))}
                                </span>
                            )}
                        </a>
                    </li>
                );
            })
        }
    </ul>
</Layout>
