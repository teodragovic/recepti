---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
    title: string;
    description?: string;
    /** Slug of the recipe currently being viewed, if any. */
    current?: string;
}

const { title, description = 'Recepti', current } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="hr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>

        <!-- PWA -->
        <link rel="manifest" href={`${base}manifest.webmanifest`} />
        <meta name="theme-color" content="#c2410c" />
        <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
        <link rel="icon" href={`${base}icons/favicon-32.png`} sizes="32x32" />
        <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-title" content="Recepti" />
        <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    </head>
    <body>
        <header class="topbar">
            <div class="topbar__inner">
                <button
                    class="hamburger"
                    id="nav-toggle"
                    type="button"
                    aria-label="Otvori meni"
                    aria-expanded="false"
                    aria-controls="nav-drawer"
                >
                    <span class="hamburger__bars" aria-hidden="true"></span>
                </button>
                <a class="topbar__brand" href={base}>Recepti</a>
            </div>
        </header>

        <Sidebar current={current} />

        <main>
            <slot />
        </main>

        <div class="pwa-actions">
            <button
                id="wake-toggle"
                class="pwa-btn"
                type="button"
                aria-pressed="false"
                hidden
                title="Spriječi gašenje ekrana"
            >
                <span class="pwa-btn__icon" aria-hidden="true">☀️</span>
                <span class="pwa-btn__label">Ekran</span>
            </button>
        </div>

        <script>
            const base = import.meta.env.BASE_URL;

            // --- Nav drawer (hamburger on every viewport) ---
            const navToggle = document.getElementById('nav-toggle');
            const navDrawer = document.getElementById('nav-drawer');
            const navBackdrop = document.getElementById('nav-backdrop');
            const navClose = document.getElementById('nav-close');

            if (navToggle && navDrawer) {
                // Everything outside the drawer, made inert while it is open so
                // Tab stays inside the menu.
                const behind = document.querySelectorAll<HTMLElement>(
                    '.topbar, main, .pwa-actions'
                );

                const setOpen = (open: boolean) => {
                    document.body.classList.toggle('nav-open', open);
                    navToggle.setAttribute('aria-expanded', String(open));
                    navToggle.setAttribute('aria-label', open ? 'Zatvori meni' : 'Otvori meni');
                    // Lift inert before moving focus back to the toggle.
                    behind.forEach((el) => (el.inert = open));
                    if (open) {
                        const first = navDrawer.querySelector<HTMLElement>(
                            '.nav-link.is-current, .nav-link'
                        );
                        first?.focus({ preventScroll: true });
                        first?.scrollIntoView({ block: 'center' });
                    } else {
                        navToggle.focus({ preventScroll: true });
                    }
                };

                navToggle.addEventListener('click', () =>
                    setOpen(!document.body.classList.contains('nav-open'))
                );
                navClose?.addEventListener('click', () => setOpen(false));
                navBackdrop?.addEventListener('click', () => setOpen(false));
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape' && document.body.classList.contains('nav-open')) {
                        setOpen(false);
                    }
                });
            }

            // --- Service worker registration ---
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', () => {
                    navigator.serviceWorker
                        .register(`${base}sw.js`, { scope: base })
                        .catch((err) => console.warn('SW registration failed:', err));
                });
            }

            // --- Screen wake lock (keep phone awake while cooking) ---
            // Native Wake Lock API only. Enabled automatically where the browser
            // allows it; the toggle lets the user turn it off (or on, if the
            // browser requires a user gesture to acquire the lock).
            const wakeToggle = document.getElementById('wake-toggle');
            const OPT_OUT_KEY = 'recepti:wake-opt-out';

            if (wakeToggle && 'wakeLock' in navigator) {
                let wakeLock: any = null;
                // Default on, unless the user has explicitly turned it off before.
                let wantAwake = localStorage.getItem(OPT_OUT_KEY) !== '1';

                wakeToggle.hidden = false;

                function reflect() {
                    const active = wakeLock !== null;
                    wakeToggle!.classList.toggle('is-active', active);
                    wakeToggle!.setAttribute('aria-pressed', String(active));
                    wakeToggle!.title = active
                        ? 'Ekran ostaje uključen — dodirni za isključivanje'
                        : 'Spriječi gašenje ekrana';
                }

                async function acquire() {
                    if (wakeLock || !wantAwake || document.visibilityState !== 'visible') return;
                    try {
                        wakeLock = await (navigator as any).wakeLock.request('screen');
                        wakeLock.addEventListener('release', () => {
                            wakeLock = null;
                            reflect();
                        });
                    } catch {
                        // e.g. NotAllowedError — needs a user gesture; leave off.
                        wakeLock = null;
                    }
                    reflect();
                }

                async function release() {
                    if (wakeLock) {
                        try {
                            await wakeLock.release();
                        } catch {
                            /* ignore */
                        }
                        wakeLock = null;
                    }
                    reflect();
                }

                wakeToggle.addEventListener('click', () => {
                    wantAwake = !wakeLock;
                    if (wantAwake) {
                        localStorage.removeItem(OPT_OUT_KEY);
                        acquire();
                    } else {
                        localStorage.setItem(OPT_OUT_KEY, '1');
                        release();
                    }
                });

                // Re-acquire when returning to the tab (locks drop on hide).
                document.addEventListener('visibilitychange', () => {
                    if (document.visibilityState === 'visible' && wantAwake) acquire();
                });

                // Try to enable automatically on load.
                acquire();
                reflect();
            }
        </script>
    </body>
</html>
